{
  "expo": {
    "name": "AUVIONA",
    "slug": "auviona",
    "scheme": "auviona",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ch.auviona.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AUVIONA uses the microphone only while the app is open and listening is on. Sound is analysed on this iPhone and held in memory just long enough to show labels and artwork; it is never recorded, saved or uploaded.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ch.auviona.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#010613",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "3d58fca3-38a8-4b29-a0ea-15182cad4a1d"
      }
    }
  }
}
